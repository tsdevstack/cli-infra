exports[`cross-provider workflow snapshots (npmAuth: true) > GCP > deploy workflow snapshot 1`] = `
"# Deploy workflow - manual trigger only
# Generated by tsdevstack infra:init-ci
# Do not edit manually - regenerate with infra:generate-ci

name: "Deploy"

on:
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        type: choice
        options:
          - dev
          - prod
      tag:
        description: 'Image tag (defaults to commit SHA)'
        required: false
        type: string

jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write # Required for WIF

    env:
      NPM_TOKEN: \${{ secrets.NPM_TOKEN }}

    steps:
      - uses: actions/checkout@v4

      # Set secret names for dynamic lookup (GitHub requires $GITHUB_ENV for secrets[env.X] pattern)
      - name: Set environment variables
        run: |
          ENV_UPPER=$(echo '\${{ inputs.environment }}' | tr '[:lower:]' '[:upper:]')
          echo "GCP_WIF_NAME=GCP_WIF_\${ENV_UPPER}" >> $GITHUB_ENV
          echo "GCP_SA_NAME=GCP_SA_\${ENV_UPPER}" >> $GITHUB_ENV
          echo "GCP_REGION_NAME=GCP_REGION_\${ENV_UPPER}" >> $GITHUB_ENV
          echo "IMAGE_TAG=\${{ inputs.tag || github.sha }}" >> $GITHUB_ENV

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Security audit
        run: npm audit --audit-level=high
        continue-on-error: true

      - name: Build
        run: npm run build

      # Ensure CLI binary is linked (workspace packages may have unresolved bin symlinks after install)
      - name: Link CLI
        run: npm rebuild @tsdevstack/cli 2>/dev/null || true

      # Authenticate to GCP via WIF
      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: \${{ secrets[env.GCP_WIF_NAME] }}
          service_account: \${{ secrets[env.GCP_SA_NAME] }}
          token_format: access_token

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.9.0

      # Enable containerd for BuildKit cache export support
      - name: Enable containerd image store
        run: |
          echo '{"features":{"containerd-snapshotter":true}}' | sudo tee /etc/docker/daemon.json
          sudo systemctl restart docker

      - name: Configure Docker for Artifact Registry
        run: echo '\${{ steps.auth.outputs.access_token }}' | docker login -u oauth2accesstoken --password-stdin https://\${{ secrets[env.GCP_REGION_NAME] }}-docker.pkg.dev

      # Free up disk space for Docker builds (GitHub runner has ~14GB free, we need more)
      - name: Free disk space
        run: |
          echo "Disk space before cleanup:"
          df -h /
          # Remove large unused tools
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          sudo rm -rf /usr/share/swift /usr/local/share/boost /usr/share/miniconda
          # Clean Docker
          docker system prune -af
          echo "Disk space after cleanup:"
          df -h /

      # Step 1: Bootstrap (enable APIs, add SA roles)
      - name: Bootstrap
        run: npx tsdevstack infra:bootstrap --env \${{ inputs.environment }}
        env:
          GCP_REGION: \${{ secrets[env.GCP_REGION_NAME] }}

      # IAM permissions take time to propagate in GCP (typically 15-60 seconds)
      # Wait to ensure Cloud Scheduler and other permissions are active
      - name: Wait for IAM propagation
        run: sleep 20

      # Step 2: Push framework secrets (skip user secrets - no prompts in CI)
      - name: Push Framework Secrets
        run: npx tsdevstack cloud-secrets:push --env \${{ inputs.environment }} --skip-user-secrets
        env:
          GCP_REGION: \${{ secrets[env.GCP_REGION_NAME] }}

      # Step 3: Full deployment (terraform → services → kong → lb)
      - name: Deploy
        run: npx tsdevstack infra:deploy --env \${{ inputs.environment }} --auto-approve --tag \${{ env.IMAGE_TAG }}
        env:
          GCP_REGION: \${{ secrets[env.GCP_REGION_NAME] }}

      # Note: Scheduled jobs are deployed separately via 'Deploy Scheduled Jobs' workflow
      # Run after services are healthy: Actions → Deploy Scheduled Jobs
"
`;

exports[`cross-provider workflow snapshots (npmAuth: true) > GCP > remove-service workflow snapshot 1`] = `
"# Remove Service workflow - manual trigger
# Generated by tsdevstack infra:generate-ci
# Do not edit manually - regenerate with infra:generate-ci
#
# This workflow removes a service from cloud (one environment at a time).
# After removing from all environments, run locally:
#   npx tsdevstack remove-service <service-name>

name: "Remove Service"

on:
  workflow_dispatch:
    inputs:
      environment:
        description: 'Target environment'
        required: true
        type: choice
        options:
          - dev
          - prod
      service_name:
        description: 'Service name to remove (e.g., order-service)'
        required: true
        type: string
      confirm:
        description: 'Type service name again to confirm'
        required: true
        type: string
      dry_run:
        description: 'Dry run (show what would be deleted without deleting)'
        required: false
        type: boolean
        default: false

jobs:
  remove:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write

    env:
      NPM_TOKEN: \${{ secrets.NPM_TOKEN }}

    steps:
      - uses: actions/checkout@v4

      # Validate confirmation matches service name
      - name: Validate confirmation
        run: |
          if [ "\${{ inputs.service_name }}" != "\${{ inputs.confirm }}" ]; then
            echo "❌ Confirmation doesn't match service name"
            echo ""
            echo "You entered:"
            echo "  Service name: \${{ inputs.service_name }}"
            echo "  Confirm:      \${{ inputs.confirm }}"
            echo ""
            echo "These must match exactly to proceed."
            exit 1
          fi
          echo "✅ Confirmation matches"

      # Set secret names for dynamic lookup (GitHub requires $GITHUB_ENV for secrets[env.X] pattern)
      - name: Set environment variables
        run: |
          ENV_UPPER=$(echo '\${{ inputs.environment }}' | tr '[:lower:]' '[:upper:]')
          echo "GCP_WIF_NAME=GCP_WIF_\${ENV_UPPER}" >> $GITHUB_ENV
          echo "GCP_SA_NAME=GCP_SA_\${ENV_UPPER}" >> $GITHUB_ENV
          echo "GCP_REGION_NAME=GCP_REGION_\${ENV_UPPER}" >> $GITHUB_ENV

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      # Ensure CLI binary is linked (workspace packages may have unresolved bin symlinks after install)
      - name: Link CLI
        run: npm rebuild @tsdevstack/cli 2>/dev/null || true

      # Authenticate to GCP via WIF
      - uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: \${{ secrets[env.GCP_WIF_NAME] }}
          service_account: \${{ secrets[env.GCP_SA_NAME] }}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.9.0

      # Generate Terraform files for this environment (needed for state sync)
      - name: Generate Terraform
        run: npx tsdevstack infra:generate --env \${{ inputs.environment }}
        env:
          GCP_REGION: \${{ secrets[env.GCP_REGION_NAME] }}

      - name: Remove service from cloud
        run: |
          FLAGS="--env \${{ inputs.environment }} --confirm"
          if [ "\${{ inputs.dry_run }}" = "true" ]; then
            FLAGS="$FLAGS --dry-run"
          fi
          npx tsdevstack infra:remove-service \${{ inputs.service_name }} $FLAGS
        env:
          GCP_REGION: \${{ secrets[env.GCP_REGION_NAME] }}

      - name: Summary
        if: success()
        run: |
          if [ "\${{ inputs.dry_run }}" = "true" ]; then
            echo "## Dry Run Complete" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "No resources were deleted. Review the output above to see what would be removed." >> $GITHUB_STEP_SUMMARY
          else
            echo "## Service Removed" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "**\${{ inputs.service_name }}** has been removed from **\${{ inputs.environment }}**." >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "### Next Steps" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "1. If this service is deployed in other environments, run this workflow for each one" >> $GITHUB_STEP_SUMMARY
            echo "2. After removing from all environments, run locally:" >> $GITHUB_STEP_SUMMARY
            echo "   \\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
            echo "   npx tsdevstack remove-service \${{ inputs.service_name }}" >> $GITHUB_STEP_SUMMARY
            echo "   \\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
            echo "3. Commit the config.json changes" >> $GITHUB_STEP_SUMMARY
            echo "4. Redeploy Kong to update routes:" >> $GITHUB_STEP_SUMMARY
            echo "   \\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
            echo "   npx tsdevstack infra:kong-deploy --env \${{ inputs.environment }}" >> $GITHUB_STEP_SUMMARY
            echo "   \\\`\\\`\\\`" >> $GITHUB_STEP_SUMMARY
          fi
"
`;
