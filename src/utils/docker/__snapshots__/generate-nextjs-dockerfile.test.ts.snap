// Rstest Snapshot v1

exports[`generateNextJsDockerfile > snapshot > should match snapshot 1`] = `
"# Next.js Dockerfile for frontend
# Generated by: npx tsdevstack infra:generate-docker
# Requires: output: "standalone" in next.config.ts

FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/bff-client/package.json ./packages/bff-client/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN --mount=type=cache,target=/root/.npm npm ci

FROM deps AS build
COPY . .
ENV NODE_ENV=production
# Build workspace dependencies first (they're TypeScript packages)
RUN npm run build --workspace=packages/bff-client
RUN npm run build --workspace=packages/shared-types
# Build the app
RUN npm run build --workspace=apps/frontend

# Production uses slim image (standalone server doesn't need build tools)
FROM node:20-slim AS production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends dumb-init \\
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME="0.0.0.0"
USER node

# Copy standalone server
COPY --chown=node:node --from=build /app/apps/frontend/.next/standalone ./
# Copy static assets
COPY --chown=node:node --from=build /app/apps/frontend/.next/static ./apps/frontend/.next/static
# Copy public folder
COPY --chown=node:node --from=build /app/apps/frontend/public ./apps/frontend/public

EXPOSE 8080
# Use shell form to override HOSTNAME (App Runner sets it to EC2 internal hostname)
CMD ["dumb-init", "sh", "-c", "HOSTNAME=0.0.0.0 exec node apps/frontend/server.js"]
"
`;
