{
  "name": "@tsdevstack/cli-infra",
  "version": "0.0.1",
  "description": "Infrastructure deployment tools for tsdevstack framework",
  "author": "tsdevstack",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsdevstack/cli-infra.git"
  },
  "homepage": "https://github.com/tsdevstack/cli-infra",
  "bugs": {
    "url": "https://github.com/tsdevstack/cli-infra/issues"
  },
  "keywords": [
    "tsdevstack",
    "cli",
    "infrastructure",
    "terraform",
    "gcp",
    "aws",
    "azure",
    "devops"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test": "rstest run",
    "test:watch": "rstest"
  },
  "peerDependencies": {
    "@tsdevstack/cli": ">=0.1.0",
    "commander": "^15.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-apprunner": "^3.984.0",
    "@aws-sdk/client-cloudfront": "^3.984.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.984.0",
    "@aws-sdk/client-dynamodb": "^3.984.0",
    "@aws-sdk/client-ecr": "^3.984.0",
    "@aws-sdk/client-ecs": "^3.984.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1095.0",
    "@aws-sdk/client-iam": "^3.984.0",
    "@aws-sdk/client-rds": "^3.1007.0",
    "@aws-sdk/client-s3": "^3.984.0",
    "@aws-sdk/client-scheduler": "^3.984.0",
    "@aws-sdk/client-servicediscovery": "^3.984.0",
    "@aws-sdk/client-sts": "^3.984.0",
    "@azure/arm-appcontainers": "^3.0.0",
    "@azure/arm-appservice": "^19.0.0",
    "@azure/arm-postgresql-flexible": "^9.0.0",
    "@azure/arm-resources": "^8.0.0",
    "@azure/arm-storage": "^20.1.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/storage-blob": "^12.31.0",
    "@google-cloud/logging": "^11.0.0",
    "@google-cloud/resource-manager": "^6.3.0",
    "@google-cloud/run": "^3.0.1",
    "@google-cloud/scheduler": "^5.4.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/service-usage": "^4.0.0",
    "@google-cloud/storage": "^7.18.0",
    "@tsdevstack/infra-core": "*",
    "google-auth-library": "^10.5.0",
    "googleapis": "^173.0.0",
    "inquirer": "^14.0.2",
    "js-yaml": "^5.2.2",
    "p-map": "^7.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.4",
    "@rstest/core": "^0.11.4",
    "@types/node": "^22.19.17",
    "eslint": "^10.7.0",
    "globals": "^17.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0"
  },
  "private": true
}
